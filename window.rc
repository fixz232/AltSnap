/////////////////////////////////////////////////////////////////////////////
IDD_WINDOWTOOL DIALOGEX 0, 0, 430, 350
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
CAPTION "圣子猫透明窗体"
FONT 10, "Microsoft YaHei UI"
BEGIN
    LTEXT           "请选择一个窗口", IDC_WT_SELECTED, 110, 24, 180, 22, SS_NOPREFIX | SS_LEFTNOWORDWRAP | SS_ENDELLIPSIS

    CONTROL         "", IDC_WT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP, 16, 62, 398, 128

    PUSHBUTTON      "刷新", IDC_WT_REFRESH, 258, 20, 62, 28
    PUSHBUTTON      "准星选窗", IDC_WT_PICKER, 328, 20, 86, 28

    LTEXT           "不透明度", IDC_WT_OPACITY_LABEL, 16, 216, 56, 22
    CONTROL         "", IDC_WT_OPACITY, "msctls_trackbar32", TBS_HORZ | WS_TABSTOP, 78, 210, 210, 32
    RTEXT           "100%", IDC_WT_PERCENT, 296, 212, 60, 28
    PUSHBUTTON      "恢复原状态", IDC_WT_RESET, 364, 210, 90, 28

    AUTOCHECKBOX    "窗口置顶", IDC_WT_TOPMOST, 16, 248, 88, 22
    AUTOCHECKBOX    "强制透明（特殊窗口）", IDC_WT_FORCE, 110, 248, 176, 22
    PUSHBUTTON      "开启本软件防录屏", IDC_WT_CAPTURE_PROTECTION, 292, 246, 128, 28

    PUSHBUTTON      "激活窗口", IDC_WT_ACTIVATE, 16, 282, 82, 28
    PUSHBUTTON      "安全镜像防录屏（实验）", IDC_WT_SECURE_MIRROR, 106, 282, 180, 28
    PUSHBUTTON      "设置", IDC_WT_SETTINGS, 300, 282, 74, 28
    PUSHBUTTON      "退出", IDC_WT_EXIT, 382, 282, 72, 28

    LTEXT           "全局控制已启用", IDC_WT_STATUS, 16, 318, 380, 22, SS_NOPREFIX
END


/////////////////////////////////////////////////////////////////////////////
IDD_ACTIONPARAM DIALOG 0, 0, 220, 80
STYLE DS_ABSALIGN | DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "高级动作"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "动作(&A):",IDC_ACTIONT,    5,  8, 50,  8
    COMBOBOX        IDC_ACTIONP0,    5, 18, 100, 160, MY_CBS_STYLE
    COMBOBOX        IDC_ACTIONP1,  110, 18, 50, 160, MY_CBS_STYLE
    EDITTEXT        IDC_ACTIONP2,  165, 18, 50,  12,  ES_AUTOHSCROLL
    LTEXT       "", IDC_ACTIONTSTRING,    8, 45, 100,  8

    DEFPUSHBUTTON   "确定",  IDOK, 108,60,50,14
    PUSHBUTTON   "取消", IDCANCEL, 165,60,50,14
END
/////////////////////////////////////////////////////////////////////////////
// Cursor
IDI_FIND                CURSOR  DISCARDABLE     "media/find.cur"

/////////////////////////////////////////////////////////////////////////////
// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_FIND                ICON    DISCARDABLE     "media/find.ico"



