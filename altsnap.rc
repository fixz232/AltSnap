#include "resource.h"
LANGUAGE 4, 2

APP_ICON ICON "media/icon.ico"
TRAY_OFF ICON "media/tray-disabled.ico"
TRAY_ON  ICON "media/tray-enabled.ico"
TRAY_SUS ICON "media/tray-suspended.ico"
IDR_ZH_CN RCDATA "../../packaging/Lang/zh_CN.ini"

#include "window.rc"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "AltSnap.exe.manifest"

#define VS_VERSION_INFO 1
VS_VERSION_INFO VERSIONINFO
  FILEVERSION VERSIONRC
  PRODUCTVERSION VERSIONRC
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS 0x40004L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "FileDescription", "圣子猫透明窗体"
      VALUE "FileVersion", APP_VERSION
      VALUE "InternalName", "ShengZiMaoTransparentWindow"
      VALUE "OriginalFilename", "圣子猫透明窗体.exe"
      VALUE "ProductName", "圣子猫透明窗体"
      VALUE "ProductVersion", APP_VERSION
      VALUE "CompanyName", "圣子猫 / AltSnap 贡献者"
      VALUE "LegalCopyright", "AltSnap 贡献者；2026 年修改"
      VALUE "Comments", "基于 AltSnap；GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
